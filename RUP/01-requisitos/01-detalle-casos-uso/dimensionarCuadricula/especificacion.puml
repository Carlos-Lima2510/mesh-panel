@startuml especificacion

skinparam linetype polyline

state SISTEMA_DISPONIBLE
state SISTEMA_DISPONIBLE_SALIDA as "SISTEMA_DISPONIBLE"

SISTEMA_DISPONIBLE -[#green]-> dimensionarCuadricula
note on link
<b>Administrador</b> solicita dimensionar cuadrícula
end note

state dimensionarCuadricula as "dimensionarCuadricula()" {

    state " " as DimensionandoCuadricula
    state c <<choice>>

    [*] -[#green]-> DimensionandoCuadricula
    note on link
    <b>Sistema</b> permite introducir:
    • filas de mesas
    • columnas por hilera
    <b>Sistema</b> permite solicitar:
    • aplicar dimensiones
    • cancelar dimensionamiento
    end note

    DimensionandoCuadricula -[#orange]-> [*]
    note on link
    [cancelación de la solicitud]
    <b>Administrador</b> solicita cancelar dimensionamiento
    <b>Sistema</b> presenta cuadro general manteniendo las dimensiones previas sin cambios
    end note

    DimensionandoCuadricula -[#green]-> c
    note on link
    <b>Administrador</b> introduce:
    • filas de mesas
    • columnas por hilera
    <b>Administrador</b> solicita aplicar dimensiones
    end note

    c -[#green]-> [*]
    note on link
    [dimensiones válidas (> 0 y dentro de límites físicos)]
    <b>Sistema</b> presenta la cuadrícula del laboratorio reestructurada con las nuevas filas y columnas
    <b>Sistema</b> presenta la división física del pasillo central preservada entre hileras
    <b>Sistema</b> presenta las nuevas dimensiones en la cabecera
    end note

    c -[#red]-> [*]
    note on link
    [valores no numéricos o fuera de límites]
    <b>Sistema</b> presenta mensaje de advertencia y mantiene las dimensiones previas
    end note
}

dimensionarCuadricula -[#green]-> SISTEMA_DISPONIBLE_SALIDA
note on link
cuadrícula del aula reestructurada con las nuevas dimensiones
end note

dimensionarCuadricula -[#red]-> SISTEMA_DISPONIBLE_SALIDA
note on link
aviso de advertencia, dimensiones previas preservadas
end note

dimensionarCuadricula -[#orange]-> SISTEMA_DISPONIBLE_SALIDA
note on link
solicitud cancelada, retorno al cuadro general
end note

@enduml
