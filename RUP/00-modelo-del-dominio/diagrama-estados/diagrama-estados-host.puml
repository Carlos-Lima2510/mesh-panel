@startuml diagrama-estados-host

state "Conectado a Red de la Universidad" as CONECTADO_UNIVERSIDAD {
    state STANDBY : • Enlace físico UP (10/100 Mbps)\n• PC apagado en reposo (S5)\n• Habilita: Encender (WoL)
    state OPERATIVO : • Enlace físico UP (1 Gbps)\n• PC encendido y comunicando (conn & 1)
    state FALLO_LOGICO : • Enlace físico UP (1 Gbps)\n• agente caído o fallo DHCP

    STANDBY -right-> OPERATIVO : Encender (WoL) [agente conecta]
    STANDBY -right-> FALLO_LOGICO : Encender (WoL) [sin agente / IP errónea]

    OPERATIVO -down-> FALLO_LOGICO : Pérdida de IP / agente
    OPERATIVO -left-> STANDBY : Apagado manual
    FALLO_LOGICO -up-> OPERATIVO : Conexión restaurada / DHCP renovado
    FALLO_LOGICO -left-> STANDBY : Apagado manual
}

state DESCONECTADO : • Enlace físico DOWN en Modo Clase\n• Anomalía: cable suelto, roseta desenchufada o corte de luz\n• Requiere: Inspección física en el aula

[*] --> STANDBY 

CONECTADO_UNIVERSIDAD -down-> DESCONECTADO : Desconexión física de la roseta
DESCONECTADO -up-> CONECTADO_UNIVERSIDAD : Reconectar cable a la roseta

CONECTADO_UNIVERSIDAD --> [*] : Retirar host del puesto
DESCONECTADO --> [*] : Retirar host del puesto

@enduml
