@startuml diagrama-clases

hide empty members

class Laboratorio {
    nombre
    modo
}

class Puesto {
    etiqueta
    fila
    columna
    toma
    puertoSwitch
}

class Host {
    nombre
    mac
    ip
}

class Switch {
    nombre
    tipo
    totalPuertos
    ipGestion
}

class Red {
    nombre
    esAislada
}

enum ModoOperativo {
    CLASE
    PRACTICA
}

enum Estado {
    OPERATIVO
    STANDBY
    FALLO_LOGICO
    RED_AISLADA
    DESCONECTADO
}

Laboratorio .. ModoOperativo
Host .. Estado

Laboratorio "1" *-- "1..*" Puesto : posee físicamente
Laboratorio "1" o-- "1..*" Switch : alberga >

Puesto "0..*" -- "1" Switch : conecta a boca >
Puesto "1" o-- "0..1" Host : aloja

Switch "1..*" -- "1" Red : da servicio a >

@enduml
